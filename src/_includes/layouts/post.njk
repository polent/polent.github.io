{% extends "layouts/base.njk" %}

{# Compute recipe data once at template scope so both head and content can use it #}
{% set recipeUrl = meta.domain + page.url %}
{% set recipeData = content | extractRecipeData(recipeUrl) %}
{% set isRenderableRecipe = isRecipe and (recipeData.ingredients | length) and (recipeData.instructions | length) %}

{# Resolve chef + cuisine at template scope so head block AND body can both use them #}
{% set recipeAuthor = meta.author.name %}
{% set recipeCuisine = null %}
{% if tags and (tags | length) %}
  {% set candidateAuthor = tags[tags | length - 1] %}
  {% if candidateAuthor and (candidateAuthor != (candidateAuthor | lower)) %}
    {% set recipeAuthor = candidateAuthor | replace('-', ' ') %}
    {% if candidateAuthor == "Hiroshi" %}
      {% set recipeCuisine = "Asia" %}
    {% elif candidateAuthor == "Emily" %}
      {% set recipeCuisine = "North American" %}
    {% elif candidateAuthor == "Isabella" %}
      {% set recipeCuisine = "Italian" %}
    {% elif candidateAuthor == "Nia" %}
      {% set recipeCuisine = "African" %}
    {% endif %}
  {% endif %}
{% endif %}
{% set recipeAuthorSlug = recipeAuthor | slug %}
{# Only a matched chef has a /chefs/<slug>/ page; the meta.author fallback does not. #}
{% set recipeAuthorIsChef = recipeAuthor != meta.author.name %}

{% block head %}
  {{ super() }}
  {% if isRenderableRecipe %}
    {% set recipeImage = null %}
    {% if recipeData.image %}
      {% set recipeImage = meta.domain + recipeData.image %}
    {% endif %}
    {% set recipeKeywords = null %}
    {% if tags and (tags | length) %}
      {% set recipeKeywords = tags | join(', ') %}
    {% endif %}
    {% set recipeSchema = {
      "@context": "https://schema.org",
      "@type": "Recipe",
      "name": title,
      "description": description or meta.description,
      "url": recipeUrl,
      "datePublished": page.date | dateToYYYYMMDD,
      "author": {
        "@type": "Person",
        "@id": meta.domain + "/chefs/" + recipeAuthorSlug + "/",
        "name": recipeAuthor,
        "url": meta.domain + "/chefs/" + recipeAuthorSlug + "/"
      },
      "image": recipeImage,
      "recipeYield": recipeData.yield,
      "recipeCuisine": recipeCuisine,
      "recipeIngredient": recipeData.ingredients,
      "recipeInstructions": recipeData.instructions,
      "suitableForDiet": "https://schema.org/VeganDiet",
      "prepTime": recipeData.prepTime,
      "cookTime": recipeData.cookTime,
      "totalTime": recipeData.totalTime,
      "nutrition": recipeData.nutrition,
      "keywords": recipeKeywords
    } %}
    <script type="application/ld+json">{{ recipeSchema | toJson | safe }}</script>

    {# BreadcrumbList: Home → Recipes → Recipe #}
    {% set breadcrumbSchema = {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": meta.domain + "/" },
        { "@type": "ListItem", "position": 2, "name": "Recipes", "item": meta.domain + "/recipes/" },
        { "@type": "ListItem", "position": 3, "name": title, "item": recipeUrl }
      ]
    } %}
    <script type="application/ld+json">{{ breadcrumbSchema | toJson | safe }}</script>
  {% endif %}
{% endblock %}

{% block content %}
  <article class="wrapper layout-grid recipe h-entry{% if isRenderableRecipe %} recipe--enhanced{% endif %}"
    {% if isRenderableRecipe %}
      data-pagefind-body
      data-recipe-slug="{{ page.fileSlug }}"
      data-recipe-title="{{ title }}"
    {% endif %}>
    {% if isRenderableRecipe %}
      {# Pagefind facets — one element per attribute (HTML disallows duplicate attribute names) #}
      <span data-pagefind-ignore data-pagefind-filter="chef:{{ recipeAuthor }}" hidden></span>
      <span data-pagefind-ignore data-pagefind-meta="chef:{{ recipeAuthor }}" hidden></span>
      {% if recipeCuisine %}
        <span data-pagefind-ignore data-pagefind-filter="cuisine:{{ recipeCuisine }}" hidden></span>
        <span data-pagefind-ignore data-pagefind-meta="cuisine:{{ recipeCuisine }}" hidden></span>
      {% endif %}
    {% endif %}
    <header class="layout-span recipe-header">
      <h1 class="page-header p-name">{{ title }}</h1>
      <p class="recipe-byline">
        <time class="dt-published" datetime="{{ page.date | dateToYYYYMMDD }}">{{ page.date | dateToDMY }}</time>
        {% if recipeAuthorIsChef %}
          <span class="p-author h-card">by <a class="p-name u-url" href="/chefs/{{ recipeAuthorSlug }}/">{{ recipeAuthor }}</a></span>
        {% endif %}
      </p>
      {# Microformats values that carry no visible text of their own. #}
      <data class="u-url" value="{{ meta.domain }}{{ page.url }}"></data>
      {% if description %}<data class="p-summary" value="{{ description }}"></data>{% endif %}
      {% if recipeData.image %}<data class="u-photo" value="{{ meta.domain }}{{ recipeData.image }}"></data>{% endif %}
      {% if tags %}
        <ul class="tags-list">
          {% for item in tags %}
            <li><a class="p-category" href="/tag/{{ item | slug }}/">{{ item }}</a></li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if isRenderableRecipe %}
        <dl class="recipe-meta" aria-label="Recipe summary">
          {% if recipeData.prepTimeText %}
            <dt>Prep</dt>
            <dd>{{ recipeData.prepTimeText }}</dd>
          {% endif %}
          {% if recipeData.yield %}
            <dt>Yield</dt>
            <dd>{{ recipeData.yield }}</dd>
          {% endif %}
          {% if recipeData.nutrition and recipeData.nutrition.calories %}
            <dt>Calories</dt>
            <dd>{{ recipeData.nutrition.calories }} kcal</dd>
          {% endif %}
        </dl>
        <div class="recipe-actions" role="group" aria-label="Recipe actions">
          <button type="button" class="recipe-action recipe-action--primary" data-action="cook-start" hidden>
            <span aria-hidden="true">▶</span> Start cooking
          </button>
          <button type="button" class="recipe-action" data-action="print-shopping" hidden>
            Print shopping list
          </button>
          <button type="button" class="recipe-action" data-action="print-full">
            Print recipe
          </button>
        </div>
      {% endif %}
    </header>

    <div class="layout-span | content-main flow recipe-body e-content">
      {% if isRenderableRecipe %}
        {{ recipeData.modifiedHtml | safe }}
      {% else %}
        {{ content | safe }}
      {% endif %}
    </div>
  </article>

  {# Ships hidden. /js/webmentions.js either unhides and fills it (consent granted) or
     removes it outright, so the no-JS and not-consented paths need no cleanup. Sits
     outside the article, and so outside data-pagefind-body. #}
  <section class="wrapper webmentions" id="responses" aria-labelledby="webmentions-title"
    data-pagefind-ignore
    data-webmentions-target="{{ meta.canonicalDomain }}{{ page.url }}" hidden>
    <h2 class="webmentions__title" id="webmentions-title">Responses from the web</h2>
    <div class="webmentions__results" aria-live="polite" aria-busy="false"></div>
  </section>
  <script src="/js/webmentions.js" defer></script>

  {% if isRenderableRecipe %}
    <dialog id="cook-mode" class="cook-mode" aria-labelledby="cook-mode-title">
      <div class="cook-mode__frame">
        <header class="cook-mode__header">
          <p class="cook-mode__title" id="cook-mode-title">{{ title }}</p>
          <button type="button" class="cook-mode__close" data-action="cook-close" aria-label="Exit cook mode">
            <span aria-hidden="true">×</span>
          </button>
        </header>

        <p class="cook-mode__progress">
          Step <span data-cook-step-current>1</span> of <span data-cook-step-total>–</span>
        </p>

        <div class="cook-mode__step" data-cook-step aria-live="polite" aria-atomic="true"></div>

        <nav class="cook-mode__nav" aria-label="Step navigation">
          <button type="button" class="cook-mode__nav-btn" data-action="cook-prev">
            <span aria-hidden="true">←</span> Previous
          </button>
          <button type="button" class="cook-mode__nav-btn cook-mode__nav-btn--next" data-action="cook-next">
            Next <span aria-hidden="true">→</span>
          </button>
        </nav>

        <details class="cook-mode__drawer">
          <summary class="cook-mode__drawer-summary">Ingredients</summary>
          <ul class="cook-mode__ingredients" data-cook-ingredients></ul>
        </details>
      </div>
    </dialog>
    <script src="/js/cook-mode.js" defer></script>
  {% endif %}
{% endblock %}
