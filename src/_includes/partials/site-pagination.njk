{# Truncated pagination with window of 5 pages around current #}
{% set currentIndex = pagination.pageNumber %}
{% set totalPages = pagination.pages | length %}
{% set windowSize = 2 %}
{% set startPage = currentIndex - windowSize %}
{% set endPage = currentIndex + windowSize %}

{# Clamp to valid range #}
{% if startPage < 0 %}{% set startPage = 0 %}{% endif %}
{% if endPage >= totalPages %}{% set endPage = totalPages - 1 %}{% endif %}

{# Reusable chevron SVGs — inline so they inherit currentColor and never depend on an emoji font #}
{% set svgChevronFirst %}<svg class="pagination-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M13 4l-4 4 4 4M7 4l-4 4 4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}
{% set svgChevronPrev %}<svg class="pagination-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 4l-4 4 4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}
{% set svgChevronNext %}<svg class="pagination-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}
{% set svgChevronLast %}<svg class="pagination-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 4l4 4-4 4M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}

<h2 class="sr-only" id="pagination-h2">Recipe Pagination</h2>
<nav class="site-pagination" aria-labelledby="pagination-h2">
  <ul>
    <li>
      {% if currentIndex == 0 %}
        <span class="pagination-btn pagination-nav pagination-disabled" aria-disabled="true" aria-label="First page">{{ svgChevronFirst | safe }}</span>
      {% else %}
        <a href="{{ pagination.href.first }}" class="pagination-btn pagination-nav" aria-label="First page">{{ svgChevronFirst | safe }}</a>
      {% endif %}
    </li>
    <li>
      {% if pagination.href.previous %}
        <a href="{{ pagination.href.previous }}" class="pagination-btn pagination-nav" aria-label="Previous page" rel="prev">{{ svgChevronPrev | safe }}</a>
      {% else %}
        <span class="pagination-btn pagination-nav pagination-disabled" aria-disabled="true" aria-label="Previous page">{{ svgChevronPrev | safe }}</span>
      {% endif %}
    </li>

    {% if startPage > 0 %}
      <li>
        <a href="{{ pagination.hrefs[0] }}" class="pagination-btn">1</a>
      </li>
      {% if startPage > 1 %}
        <li><span class="pagination-ellipsis" aria-hidden="true">&hellip;</span></li>
      {% endif %}
    {% endif %}

    {%- for pageEntry in pagination.pages %}
      {% if loop.index0 >= startPage and loop.index0 <= endPage %}
        <li>
          <a href="{{ pagination.hrefs[ loop.index0 ] }}" class="pagination-btn{% if page.url == pagination.hrefs[ loop.index0 ] %} pagination-current{% endif %}"
            {% if page.url == pagination.hrefs[ loop.index0 ] %}aria-current="page"{% endif %}>
            {{ loop.index }}
          </a>
        </li>
      {% endif %}
    {%- endfor %}

    {% if endPage < totalPages - 1 %}
      {% if endPage < totalPages - 2 %}
        <li><span class="pagination-ellipsis" aria-hidden="true">&hellip;</span></li>
      {% endif %}
      <li>
        <a href="{{ pagination.hrefs[totalPages - 1] }}" class="pagination-btn">{{ totalPages }}</a>
      </li>
    {% endif %}

    <li>
      {% if pagination.href.next %}
        <a href="{{ pagination.href.next }}" class="pagination-btn pagination-nav" aria-label="Next page" rel="next">{{ svgChevronNext | safe }}</a>
      {% else %}
        <span class="pagination-btn pagination-nav pagination-disabled" aria-disabled="true" aria-label="Next page">{{ svgChevronNext | safe }}</span>
      {% endif %}
    </li>
    <li>
      {% if currentIndex == totalPages - 1 %}
        <span class="pagination-btn pagination-nav pagination-disabled" aria-disabled="true" aria-label="Last page">{{ svgChevronLast | safe }}</span>
      {% else %}
        <a href="{{ pagination.href.last }}" class="pagination-btn pagination-nav" aria-label="Last page">{{ svgChevronLast | safe }}</a>
      {% endif %}
    </li>
  </ul>
</nav>
